# Copy this file to .env and replace the placeholders with your own keys.
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key
OPENAI_API_KEY=your_openai_api_key

# Streamlit-to-FastAPI connection settings
BACKEND_BASE_URL=http://127.0.0.1:3003
BACKEND_REQUEST_TIMEOUT_SECONDS=30
BACKEND_STREAM_READ_TIMEOUT_SECONDS=120

# Backend operational logging (json or console; DEBUG, INFO, WARNING, or ERROR)
APP_LOG_FORMAT=json
APP_LOG_LEVEL=INFO
